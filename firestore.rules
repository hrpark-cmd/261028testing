rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 파일 내용을 붙여넣고 "게시"하세요.
// ① ADMIN_EMAILS 를 src/config/site.ts 의 ADMIN_EMAILS 와 똑같이 맞추세요.
// ② 읽기 공개 범위는 PUBLIC_READ 한 줄로 정합니다.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 설정 ─────────────────────────────────────
    function ADMIN_EMAILS() {
      return ['professor@example.com'];
    }
    // true: 누구나 읽기 / signedIn(): 로그인한 사람만 읽기
    function PUBLIC_READ() {
      return true;
    }

    // ── 공통 함수 ────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ADMIN_EMAILS();
    }
    function isAuthor(data) {
      return signedIn() && data.authorId == request.auth.uid;
    }
    function validContent(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.summary is string && d.summary.size() <= 20000
        && d.tags is list && d.tags.size() <= 20
        && d.links is list && d.links.size() <= 20;
    }

    // ── 연구 / 수업자료: 읽기 공개, 쓰기는 관리자만 ──
    match /research/{id} {
      allow read: if PUBLIC_READ();
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if isAdmin();
    }
    match /courses/{id} {
      allow read: if PUBLIC_READ();
      allow create, update: if isAdmin() && validContent(request.resource.data)
        && request.resource.data.course is string
        && request.resource.data.week is number;
      allow delete: if isAdmin();
    }

    // ── 토론 게시글 ─────────────────────────────
    match /posts/{postId} {
      allow read: if PUBLIC_READ();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;

      // 작성자·관리자: 수정 (작성자 정보는 바꿀 수 없음)
      allow update: if (isAuthor(resource.data) || isAdmin())
        && request.resource.data.authorId == resource.data.authorId;

      // 로그인 사용자: 댓글 작성/삭제 시 댓글 수(commentCount)만 ±1
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1);

      allow delete: if isAuthor(resource.data) || isAdmin();

      // ── 댓글 ──────────────────────────────────
      match /comments/{commentId} {
        allow read: if PUBLIC_READ();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.createdAt == request.time;
        // 댓글 작성자, 관리자, 그리고 글 작성자(글을 지울 때 댓글도 함께 지우기 위해)
        allow delete: if isAuthor(resource.data) || isAdmin()
          || isAuthor(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow update: if false;
      }
    }

    // ── 사용자 프로필 ───────────────────────────
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
