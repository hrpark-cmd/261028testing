# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# Netlify 에서는: Site configuration > Environment variables 에 같은 이름으로 등록합니다.

# true 로 바꾸면 Firebase 사용 (Firebase 연동 작업 이후에만 동작)
VITE_USE_FIREBASE=false

# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹 앱) 에서 확인
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
